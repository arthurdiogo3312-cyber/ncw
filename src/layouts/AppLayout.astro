---
import Sidebar from "../components/Sidebar.astro";
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = "NCW | Built For You" } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="NCW, uma experiencia de e-commerce social para descobrir, montar e comprar looks."
    />
    <title>{title}</title>
    <script is:inline>
      const theme = localStorage.getItem("ncw-theme") || "clean";
      const accent = localStorage.getItem("ncw-accent") || "#2f5d50";
      document.documentElement.dataset.theme = theme;
      document.documentElement.dataset.layout = localStorage.getItem("ncw-layout") || "market";
      document.documentElement.style.setProperty("--accent", accent);
    </script>
    <script is:inline src="/ncw-api.js"></script>
  </head>
  <body>
    <div class="app-shell">
      <Sidebar />
      <main class="app-main">
        <slot />
      </main>
    </div>
  </body>
</html>
