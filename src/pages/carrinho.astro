---
import { LockKeyhole } from "@lucide/astro";
import AppLayout from "../layouts/AppLayout.astro";
---

<AppLayout title="NCW | Carrinho">
  <header class="page-header">
    <div>
      <p class="kicker">Carrinho</p>
      <h1>Compra sem dados sensiveis.</h1>
      <p class="lead">Por enquanto o site salva somente produtos, valores e status da compra. Pagamento entra depois com Stripe.</p>
    </div>
  </header>

  <section class="content-grid">
    <div class="panel cart-list" data-cart-list>
      <p class="muted" style="padding:18px;">Carrinho vazio.</p>
    </div>

    <aside class="panel summary">
      <h2>Resumo</h2>
      <div class="summary-row"><span>Subtotal</span><strong data-subtotal>R$ 0,00</strong></div>
      <div class="summary-row"><span>Frete estimado</span><strong data-shipping>R$ 24,90</strong></div>
      <div class="summary-row total"><span>Total</span><strong data-total>R$ 24,90</strong></div>
      <button class="btn primary" type="button" data-checkout style="width:100%; margin-top:16px;"><LockKeyhole size={18} /> Registrar compra</button>
      <p class="notice" data-cart-message style="margin-top:14px;">Entre em /conta antes de registrar uma compra.</p>
    </aside>
  </section>

  <script>
    const list = document.querySelector("[data-cart-list]");
    const subtotalText = document.querySelector("[data-subtotal]");
    const shippingText = document.querySelector("[data-shipping]");
    const totalText = document.querySelector("[data-total]");
    const message = document.querySelector("[data-cart-message]");
    const shipping = 24.9;

    function subtotal() {
      return NCW.getCart().reduce((sum, item) => sum + Number(item.price) * Number(item.quantity || 1), 0);
    }

    function renderCart() {
      const cart = NCW.getCart();
      list.innerHTML = cart.length ? "" : '<p class="muted" style="padding:18px;">Carrinho vazio.</p>';
      cart.forEach((item) => {
        const row = document.createElement("article");
        row.className = "cart-item";
        const thumb = item.image
          ? `<img class="cart-thumb" src="${item.image}" alt="${item.name}" loading="lazy" />`
          : `<div class="cart-thumb color-thumb" style="--item-color:${item.color || "#2f3437"}"></div>`;
        row.innerHTML = `
          ${thumb}
          <div><h2>${item.name}</h2><span class="muted">${item.category || "Produto"} · qtd. ${item.quantity || 1}</span></div>
          <div class="cart-price"><strong>${NCW.money(Number(item.price) * Number(item.quantity || 1))}</strong><button class="icon-action" type="button" data-remove="${item.id}" aria-label="Remover ${item.name}"></button></div>
        `;
        row.querySelector("[data-remove]").innerHTML = `<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 14H6L5 6"/></svg>`;
        list.appendChild(row);
      });
      const sub = subtotal();
      subtotalText.textContent = NCW.money(sub);
      shippingText.textContent = NCW.money(cart.length ? shipping : 0);
      totalText.textContent = NCW.money(cart.length ? sub + shipping : 0);
    }

    list.addEventListener("click", (event) => {
      const button = event.target.closest("[data-remove]");
      if (!button) return;
      NCW.removeFromCart(button.dataset.remove);
      renderCart();
    });

    document.querySelector("[data-checkout]").addEventListener("click", async () => {
      const cart = NCW.getCart();
      if (!cart.length) {
        message.textContent = "Carrinho vazio.";
        return;
      }
      const userId = NCW.currentUserId();
      if (!userId) {
        message.textContent = "Entre em /conta antes de registrar a compra.";
        return;
      }
      const total = subtotal() + shipping;
      const items = cart.map((item) => `${item.quantity || 1}x ${item.name}`).join(", ");
      await NCW.request(`/users/${userId}/purchases`, {
        method: "POST",
        body: JSON.stringify({ title: "Compra NCW", items, total, createdAt: new Date().toLocaleDateString("pt-BR") }),
      });
      NCW.setCart([]);
      renderCart();
      message.textContent = "Compra registrada na sua conta. Pagamento Stripe entra na proxima etapa.";
    });

    renderCart();
  </script>
</AppLayout>
